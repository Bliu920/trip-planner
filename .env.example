SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key
OPENAI_API_KEY=your-openai-api-key
# Planner and web research. Use gpt-6-luna explicitly for lower-cost evaluation.
# CODEX_MODEL does not configure this application's agent.
# Requirements/review use medium; assembly/pricing/reporting and fact research use low.
OPENAI_MODEL=gpt-6.1-terra
# Independent evaluator; only this model is accepted until the guide is updated.
EVAL_JUDGE_MODEL=gpt-6.1-terra
# Independent low-cost project title generator.
OPENAI_TITLE_MODEL=gpt-6-luna
# Optional provider web search. Catalog lookup works without it.
AGENT_WEB_SEARCH=true
# Enable after the working_drafts migration. Keeps private progress for exact-input Retry.
AGENT_DURABLE_DRAFTS=false
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Server-only HeiGIT geocoding and walking/driving estimates. Optional.
HEIGIT_API_KEY=
