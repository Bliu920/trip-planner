SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6.1-terra
# Independent low-cost project title generator.
OPENAI_TITLE_MODEL=gpt-6-luna
# Optional provider web search. Catalog lookup works without it.
AGENT_WEB_SEARCH=true
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Server-only cleanup endpoint secret. Configure the same value in your trusted scheduler.
# Use at least 32 random characters; leave unset until cleanup is configured.
DOCUMENT_CLEANUP_SECRET=
